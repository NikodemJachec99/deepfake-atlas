# Postgres (źródło prawdy) + pgvector
POSTGRES_USER=hack
POSTGRES_PASSWORD=hack
POSTGRES_DB=deepfake_atlas
DATABASE_URL=postgres://hack:hack@db:5432/deepfake_atlas

# Porty na hoście. Zmień, jeśli 8000 albo 3000 masz zajęte, i dopisz nowy adres interfejsu do CORS_ALLOWED_ORIGINS.
BACKEND_PORT=8000
FRONTEND_PORT=3000
# Porty usług pomocniczych na hoście. Zmień tylko te, które masz zajęte.
DB_PORT=5432
REDIS_PORT=6380
TEMPORAL_PORT=7233
TEMPORAL_UI_PORT=8233
S3_PORT=9000
S3_CONSOLE_PORT=9001
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
OPENSEARCH_PORT=9200
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
# Gwiazdka pozwala łączyć się z drugiego komputera po adresie w sieci lokalnej. Tylko do pracy lokalnej i demo.
DJANGO_ALLOWED_HOSTS=*
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Analiza: temporal (compose) | thread (lokalnie bez Temporala) | sync (testy)
ANALYSIS_RUNNER=temporal
TEMPORAL_ADDRESS=temporal:7233

# Magazyn dowodów: s3 (RustFS w compose) | local
ARTIFACT_BACKEND=s3
S3_ENDPOINT_URL=http://s3:9000
S3_ACCESS_KEY=scamdna
S3_SECRET_KEY=scamdna-secret
S3_BUCKET=evidence

# Projekcje
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=scamdna-neo4j
OPENSEARCH_URL=http://opensearch:9200

# Crawler. Oszuści blokują adresy centrów danych: docelowo proxy z polskim adresem domowym lub mobilnym.
CRAWLER_PROXY=

# Źródła danych
META_AD_LIBRARY_TOKEN=

# Jev jest usługą zewnętrzną. Przed przekazaniem danych spraw potwierdź uprawnienia.
JEV_MODE=off
JEV_MODEL=jev-1.14.0
TYPESAFE_API_KEY=
JEV_TIMEOUT=20
JEV_MAX_REQUESTS=100
JEV_BUDGET_USD=0.10
JEV_PRICE_PER_MTOK=0.042
JEV_ALLOW_CASE_DATA=false
